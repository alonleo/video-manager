# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会提交。

# ---------- 数据库（SQLite，零运维）----------
# 默认落在 data/video_manage.db，一般无需修改
# DATABASE_URL=sqlite+aiosqlite:///./data/video_manage.db
SQLITE_BUSY_TIMEOUT_MS=15000

# ---------- Redis（任务队列，docker compose 起的项目专属实例）----------
REDIS_URL=redis://127.0.0.1:6399/0

# ---------- 并发上限（内存约 15GB 可用，转录必须串行）----------
TRANSCODE_MAX_JOBS=2
TRANSCRIBE_MAX_JOBS=1
DOWNLOAD_MAX_JOBS=2

# ---------- 磁盘保护：转码缓存硬上限 ----------
CACHE_MAX_GB=100
HLS_SESSION_TTL_MIN=30
# TS 播放缓存优先保护最近使用的文件；准备期间保留至少 512MB 可用空间
PLAYBACK_MIN_FREE_MB=512
# 单次 TS 准备超时（秒）；TS 准备串行，H.264 编码器使用 2 线程
PLAYBACK_PREPARE_TIMEOUT_SEC=7200

# ---------- ffmpeg / 硬件加速 ----------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VAAPI_DEVICE=/dev/dri/renderD128
# 实测 VAAPI 硬编可用；硬解在 Phase 2 验证后置 true
VAAPI_HWACCEL_DECODE=false

# ---------- OpenList 网盘网关 ----------
OPENLIST_BASE_URL=http://127.0.0.1:5244

# ---------- LLM（OpenAI 兼容协议，仅文本上云）----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- ASR ----------
ASR_DEFAULT_ENGINE=sensevoice
ASR_DEFAULT_MODEL=iic/SenseVoiceSmall
ASR_WHISPER_MODEL=large-v3

# ---------- 服务 ----------
API_HOST=127.0.0.1
API_PORT=8420
